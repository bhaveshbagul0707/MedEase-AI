# Application
APP_NAME=MedEase AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (local development placeholder)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medease_local
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/medease_local

# JWT
SECRET_KEY=replace-with-a-long-random-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Optional AI providers
LLM_PROVIDER=mock
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# Optional services
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Uploads
UPLOADS_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
